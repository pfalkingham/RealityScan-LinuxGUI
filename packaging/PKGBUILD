# Maintainer: Peter Falkingham
# Build from the local checkout: cd packaging && makepkg -si
pkgname=realityscan-gtk
pkgver=0.1.0
pkgrel=1
pkgdesc="Native GTK4 front-end for RealityScan running headless under Wine (Heroic/Proton)"
arch=('x86_64')
url="https://github.com/pfalkingham/realityscan-gtk"
license=('MIT')
depends=('gtk4' 'libadwaita' 'libepoxy' 'umu-launcher')
makedepends=('cargo')
optdepends=('heroic-games-launcher-bin: installs RealityScan and Proton')
source=()
sha256sums=()

prepare() {
  cd "$startdir/.."
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$startdir/.."
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release -p realityscan-gtk
}

package() {
  cd "$startdir/.."
  install -Dm755 "$srcdir/target/release/realityscan-gtk" "$pkgdir/usr/bin/realityscan-gtk"
  install -Dm644 packaging/org.realityscan_gtk.RealityScanGtk.desktop \
    "$pkgdir/usr/share/applications/org.realityscan_gtk.RealityScanGtk.desktop"
  install -Dm644 packaging/org.realityscan_gtk.RealityScanGtk.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.realityscan_gtk.RealityScanGtk.svg"
  install -Dm644 packaging/org.realityscan_gtk.RealityScanGtk.metainfo.xml \
    "$pkgdir/usr/share/metainfo/org.realityscan_gtk.RealityScanGtk.metainfo.xml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/usage.md "$pkgdir/usr/share/doc/$pkgname/usage.md"
}
